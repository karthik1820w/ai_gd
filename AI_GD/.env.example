# Copy to .env. The running app reads this file. Never commit the real .env.

DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Free language model. Groq does not require a credit card: https://console.groq.com
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY=""
AI_MODEL="llama-3.3-70b-versatile"

# Optional SMTP for password reset and invite email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Quorum <noreply@localhost>"

# Optional TURN for callers on strict networks. STUN is used by default.
LIVEKIT_HOST="http://127.0.0.1:7880"
LIVEKIT_API_KEY="quorum"
LIVEKIT_API_SECRET="replace-with-a-long-random-string"
# Optional. Defaults to this computer's LAN address so other devices can connect.
LIVEKIT_NODE_IP=""

STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_URL=""
TURN_USERNAME=""
TURN_PASSWORD=""

# Demo accounts created by `npm run seed`. Change them on a shared machine.
SEED_HOST_EMAIL="host@quorum.local"
SEED_PARTICIPANT_EMAIL="participant@quorum.local"
SEED_PASSWORD="Quorum-demo-2026"
