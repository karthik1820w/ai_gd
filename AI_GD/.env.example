# Copy to .env. The running app reads this file. Never commit the real .env.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"
TRUST_PROXY="off"
COOKIE_SECURE=""

# Optional Gemini AI. Use a server-side key; never prefix these with NEXT_PUBLIC_.
AI_ENABLED="on"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEY=""
GEMINI_FLASH_API_KEY=""
GEMINI_FLASH_MODEL="gemini-2.5-flash"
GEMINI_FINAL_MODEL=""
GEMINI_CONCURRENCY="4"
GEMINI_MAX_QUEUE="100"
GEMINI_GROUNDING="off"
AI_MAX_CALLS_PER_ROOM="600"
AI_WEIGHTS="40,25,35"
REPORT_VISIBILITY="own"

# Optional SMTP for password reset and invite email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Quorum <noreply@localhost>"

# Optional TURN for callers on strict networks. STUN is used by default.
LIVEKIT_HOST="http://127.0.0.1:7880"
LIVEKIT_API_KEY="quorum"
LIVEKIT_API_SECRET="replace-with-a-long-random-string"
LIVEKIT_BINARY=""
# Optional. Defaults to this computer's LAN address so other devices can connect.
LIVEKIT_NODE_IP=""

STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_URL=""
TURN_USERNAME=""
TURN_PASSWORD=""

# The host email is fixed in the application. New public signups are participants.
SEED_PARTICIPANT_EMAIL="participant@quorum.local"
SEED_PASSWORD="replace-with-a-unique-password-at-least-16-characters"
