# Copy to .env (local) or add these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit the real values.

# ---- Required ----
# PostgreSQL connection string.
# Supabase + Vercel: do NOT use the "Direct connection" (db.<ref>.supabase.co) - it is IPv6-only and
# Vercel cannot reach it. In Supabase click Connect -> "Session pooler" and paste that string:
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# If the password has special characters (@ : / # ?), URL-encode them (@ becomes %40).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optional. Only if DATABASE_URL is the Transaction pooler (port 6543): put the Session pooler
# string here so the schema can be applied during the build.
# DIRECT_URL=""
# Any long random string (32+ characters). Signs login cookies.
JWT_SECRET="replace-with-a-long-random-secret"

# The one host account. You choose both values; the host signs in with them.
# Change HOST_PASSWORD here to change the host password.
HOST_EMAIL="host@example.com"
HOST_PASSWORD="replace-with-a-strong-password"

# ---- Video calls (LiveKit Cloud: https://cloud.livekit.io -> Settings -> Keys) ----
LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# ---- Optional ----
# Gemini key (https://aistudio.google.com/apikey). Without it, scoring uses the built-in heuristics.
GEMINI_API_KEY="your-gemini-api-key"
