{
  "name": "quorum",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx scripts/start-dev.mjs",
    "dev:https": "node --import tsx scripts/start-dev.mjs --https",
    "build": "next build",
    "start": "node --import tsx scripts/start-production.mjs",
    "start:deploy": "prisma db push --skip-generate && node --import tsx scripts/start-production.mjs",
    "fetch:livekit": "node scripts/fetch-livekit.mjs",
    "setup": "node scripts/setup.mjs",
    "cert": "tsx scripts/make-cert.ts",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^0.544.0",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "selfsigned": "^2.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}